# Supabase project URL (https://<ref>.supabase.co) — Settings → API → Project URL
VITE_SUPABASE_URL=
# Supabase anon / public key — Settings → API → anon public. Never the service_role key.
VITE_SUPABASE_ANON_KEY=
# Shop PIN for the unlock screen. Baked into the build as a SHA-256 hash.
VITE_SHOP_PIN=
